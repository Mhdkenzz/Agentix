#!/usr/bin/env bash
# Fake Codex CLI for the browser tests: canned JSONL, no network, no model.
if [ "$1" = "--version" ]; then
  echo "codex-cli 0.162.1"
  exit 0
fi

if [ "$1 $2" = "debug models" ]; then
  echo '{"models":[{"slug":"gpt-6.1-sol","display_name":"GPT-6.1-Sol","description":"Latest workhorse model for coding and everyday work.","visibility":"list","priority":1,"default_reasoning_level":"low","supported_reasoning_levels":[{"effort":"low"},{"effort":"medium"},{"effort":"high"}]},{"slug":"gpt-6-astra","display_name":"GPT-6-Astra","description":"Frontier intelligence.","visibility":"list","priority":2},{"slug":"gpt-reserve","visibility":"hide","priority":9}]}'
  exit 0
fi

echo "{\"type\":\"thread.started\",\"thread_id\":\"th-$RANDOM$RANDOM\"}"
echo '{"type":"turn.started"}'
# Leave a change in the working folder, so a worker's git worktree has something to diff and merge.
echo "// added by codex" >> app.js
echo '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"Scaffolded index.html and app.js."}}'
echo '{"type":"turn.completed","usage":{"input_tokens":1200,"output_tokens":300}}'
