{
  "name": "agentix",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent orchestration — web dashboard + CLI",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/server/test/*.test.ts",
    "typecheck": "npm run typecheck -w @agentix/web && npm run typecheck -w @agentix/server",
    "lint": "eslint .",
    "server": "node packages/cli/src/agentix.ts server",
    "dev:web": "npm run dev -w @agentix/web",
    "build": "npm run build -w @agentix/web",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
